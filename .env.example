# VeritusOS Community — environment template
# Copy to .env.local and fill in the values for your deployment.
# Never commit real secrets. .env and .env.* are gitignored (except this template).

# ─────────────────────────────────────────────────────────────
# Supabase mode (cloud / hosted backend)
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ─────────────────────────────────────────────────────────────
# Local physical server mode (Windows server @ Colégio Alta Vista)
# Serves Checkout/Search from the on-prem local API instead of Supabase.
# ─────────────────────────────────────────────────────────────
VITE_CHECKOUT_LOCAL_MODE=true
VITE_LOCAL_API_URL=http://<SERVER_IP>:3333
VITE_CHECKOUT_SUPABASE_LOW_EGRESS=false
